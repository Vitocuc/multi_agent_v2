# Copy this file to .env and fill in real values.
# Never commit .env. This file (example) is safe to commit — it contains no secrets.

# OIDC IdP configuration (provided by the concessionaire)
OIDC_JWKS_URI=https://idp.concessionaire.example.com/.well-known/jwks.json
OIDC_AUDIENCE=protegopay-pilot
OIDC_ISSUER=https://idp.concessionaire.example.com

# Session JWT signing secret (generate with: openssl rand -hex 32)
SESSION_SECRET=REPLACE_WITH_STRONG_RANDOM_SECRET

# HMAC key for tokenising external user IDs (generate with: openssl rand -hex 32)
EXTERNAL_ID_HMAC_KEY=REPLACE_WITH_STRONG_RANDOM_SECRET

# Redis
REDIS_URL=redis://localhost:6379/0

# Database (PostgreSQL in production)
DATABASE_URL=postgresql://user:password@localhost:5432/protegopay

# App
ENVIRONMENT=development
